{
  "framework": null,
  "functions": {
    "api/process.js": {
      "maxDuration": 300
    },
    "api/presign.js": {
      "maxDuration": 30
    },
    "api/upload-cleanup.js": {
      "maxDuration": 30
    }
  },
  "rewrites": [
    { "source": "/", "destination": "/public/index.html" },
    { "source": "/(.*)", "destination": "/public/$1" }
  ]
}
